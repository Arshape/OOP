public class Main {
    public static void main(String[] args){
        int[] arr = {3, 1, 7, 4, 9, 3, 6, 0, 2};
        Sort.sort(arr);
        for (int i = 0; i < arr.length; ++i) System.out.print(arr[i] + " ");
    }
}

class Sort {
    static void sort(int[] arr){
        int n = arr.length;
        for (int i = 1; i < n; ++i){
            int key = arr[i];
            int j = i - 1;
            while (j >= 0 && arr[j] > key){
                arr[j + 1] = arr[j];
                --j;
            }
            arr[j + 1] = key;
        }
    }
}
